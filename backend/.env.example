# ---------------------------------------------------------------------------
# StayNearby — backend environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
# Comma separated list of allowed browser origins (explicit, never "*" for auth APIs)
CORS_ORIGINS=http://localhost:3000
# Public base URL of this API (used in emails, OpenAPI servers, cookie domain checks)
API_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Datastores
MONGODB_URI=mongodb://127.0.0.1:27017/rental_marketplace
REDIS_URL=redis://127.0.0.1:6379
# Set to false only for local development without Redis (degraded: no queues/rate limits)
REDIS_REQUIRED=true

# Auth / crypto (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-hex
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Secret used to derive HMAC hashes for refresh tokens and OTPs at rest
TOKEN_HASH_SECRET=replace-with-64-char-random-hex
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Password hashing (argon2id preferred; bcrypt is the fallback)
PASSWORD_HASH_ALGO=argon2id

# Object storage: cloudinary | s3 | local
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=

# Email (transactional provider)
EMAIL_DRIVER=console
EMAIL_FROM="StayNearby <no-reply@example.com>"
EMAIL_API_KEY=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# SMS / OTP provider
SMS_DRIVER=console
SMS_API_KEY=
SMS_SENDER_ID=

# Maps / geocoding provider (replaceable through MapProvider abstraction)
MAP_PROVIDER=nominatim
MAP_PROVIDER_KEY=
MAP_DEFAULT_CENTER_LAT=25.5941
MAP_DEFAULT_CENTER_LNG=85.1376

# Rate limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
# Trusted proxy hops in front of the API (0 = direct connection, 1 = one load balancer)
TRUST_PROXY=0

# Observability
LOG_LEVEL=debug
SERVICE_NAME=rental-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Uploads
MAX_UPLOAD_MB=8
MAX_IMAGES_PER_PROPERTY=20
