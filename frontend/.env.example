# ---------------------------------------------------------------------------
# Frontend environment — only values that are safe to expose to the browser.
# NEVER put API secrets, database URLs or signing keys in NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------

# Backend API base URL (versioned)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Public origin of this site, used for canonical URLs, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Socket.IO endpoint (defaults to NEXT_PUBLIC_API_URL without the /api/v1 suffix)
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# Raster tile template for the map. Replace with a keyed provider in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
